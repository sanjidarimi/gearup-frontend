# Base URL of the GearUp backend API, including the /api prefix.
# Browser requests go through the Next.js /api route handler, which forwards
# them here with the user's httpOnly access token.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional: server-only override (takes priority over the public value).
# API_BASE_URL=http://localhost:5000/api
